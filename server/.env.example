# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill in the values.
#   cp server/.env.example server/.env
#
# Every variable below is validated on boot by server/src/env.ts. If one is
# missing or malformed the server refuses to start and prints which one, rather
# than failing later with a confusing runtime error.
#
# .env is gitignored. Never commit real values.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# development | test | production
# In production the API also serves the built React app from the same origin
# and CORS is switched off, since there is no cross-origin request to allow.
NODE_ENV=development

# Set false to run the API on its own without serving the React build, e.g. if
# you deploy the frontend separately.
SERVE_CLIENT=true

# Port the API listens on. Railway and most hosts set this for you, so leave it
# unset in deployment and let the platform inject it.
PORT=4000


# --- Database --------------------------------------------------------------

# SQLite connection string, relative to server/prisma/.
# In deployment, point this at a mounted volume so the file survives restarts:
#   DATABASE_URL="file:/data/library.db"
# To move to Postgres later, change the datasource provider in
# prisma/schema.prisma and put the Postgres URL here instead.
DATABASE_URL="file:./data/library.db"


# --- Authentication --------------------------------------------------------

# Signing key for JWTs. Minimum 16 characters, and the server will refuse to
# boot in production while this is still the development default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"

# How long a session lasts before the user has to sign in again.
JWT_EXPIRES_DAYS=7


# --- Development only ------------------------------------------------------

# Origin allowed through CORS while the Vite dev server runs separately.
# Ignored entirely when NODE_ENV=production.
CLIENT_ORIGIN="http://localhost:5173"


# --- Staff account ---------------------------------------------------------

# Upserted on every boot so a fresh deployment always has a way in.
# The original C++ project hardcoded Admin/admin123, but that password fails
# the project's own password policy, so the default here is Admin@123.
# Change ADMIN_PASSWORD before deploying anywhere public.
ADMIN_USERNAME="Admin"
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="Admin@123"


# --- Library rules ---------------------------------------------------------

# The C++ original accepted an email only if it contained "@gmail.com".
# true restores that rule; false accepts any valid address.
REQUIRE_GMAIL=false

# Days a book stays out before it counts as overdue.
# The original tracked no due dates at all.
LOAN_DAYS=14

# Hours a returned book is held for the next person in the queue before the
# hold expires and it passes to whoever is behind them.
HOLD_HOURS=48

# Maximum books one member may have out at once. 0 means unlimited, which is
# what the original allowed.
MAX_ACTIVE_LOANS=0
